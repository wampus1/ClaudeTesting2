# Optional. Keys can be entered on the game's title screen instead; these are
# only used when the title screen leaves the key blank. The server loads this file itself.

# Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# GPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional settings
# DESCEND_MODEL_ANTHROPIC=claude-opus-5   # Claude narrator model
# DESCEND_MODEL_OPENAI=gpt-6-astra        # GPT narrator model (a key check picks the best one your key can use)
# DESCEND_IMAGE_MODEL=gpt-image-2         # GPT illustration model
# DESCEND_IMAGE_QUALITY=medium            # low | medium | high  (image cost and speed)
# DESCEND_EFFORT=medium                   # low | medium | high | xhigh | max  (lower = faster turns)
# DESCEND_FALLBACKS=on                    # Claude only: set to off to disable server-side refusal fallbacks
# DESCEND_MOCK=1                          # force the canned demo narrator; no API calls
# PORT=3000
# HOST=127.0.0.1                          # keep local: anyone who can reach the server can use your keys
