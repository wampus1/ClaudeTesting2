# Copy to .env and fill in. The server loads it automatically.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional settings
# DESCEND_MODEL=claude-opus-5     # the narrator model
# DESCEND_EFFORT=medium           # low | medium | high | xhigh | max  (lower = faster turns)
# DESCEND_FALLBACKS=on            # set to off to disable server-side refusal fallbacks
# DESCEND_MOCK=1                  # play with a canned narrator; no API calls
# PORT=3000
# HOST=127.0.0.1                  # keep local: anyone who can reach the server spends your key
